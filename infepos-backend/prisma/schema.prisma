generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Business tenant
model Tenant {
  id                   String                @id @default(uuid()) @db.Uuid
  name                 String                @db.VarChar(255)
  code                 String                @unique @db.VarChar(100)
  email                String?               @db.VarChar(255)
  phone                String?               @db.VarChar(50)
  status               TenantStatus          @default(ACTIVE)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles                Role[]
  stores               Store[]
  users                User[]
  products             Product[]
  inventories          Inventory[]
  sales                Sale[]
  suppliers            Supplier[]
  purchases            Purchase[]
  goodsReceipts        GoodsReceipt[]
  stockMovements       StockMovement[]
  inventoryAdjustments InventoryAdjustment[]
  stockTransfers       StockTransfer[]
  customers            Customer[]
  saleReturns          SaleReturn[]
  syncEvents           SyncEvent[]
  Shift                Shift[]

  @@map("tenants")
}

/// Physical retail outlet
model Store {
  id                   String                @id @default(uuid()) @db.Uuid
  tenantId             String                @map("tenant_id") @db.Uuid
  code                 String                @db.VarChar(100)
  name                 String                @db.VarChar(255)
  email                String?               @db.VarChar(255)
  phone                String?               @db.VarChar(50)
  addressLine1         String?               @map("address_line_1") @db.VarChar(255)
  addressLine2         String?               @map("address_line_2") @db.VarChar(255)
  city                 String?               @db.VarChar(100)
  state                String?               @db.VarChar(100)
  postalCode           String?               @map("postal_code") @db.VarChar(50)
  country              String?               @db.VarChar(100)
  timezone             String?               @default("UTC") @db.VarChar(50)
  currency             String?               @default("USD") @db.VarChar(10)
  isDefault            Boolean               @default(false) @map("is_default")
  status               StoreStatus           @default(ACTIVE)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users                User[]
  inventories          Inventory[]
  sales                Sale[]
  purchases            Purchase[]
  goodsReceipts        GoodsReceipt[]
  stockMovements       StockMovement[]
  inventoryAdjustments InventoryAdjustment[]
  sourceTransfers      StockTransfer[]       @relation("SourceTransfers")
  destinationTransfers StockTransfer[]       @relation("DestinationTransfers")
  saleReturns          SaleReturn[]
  syncEvents           SyncEvent[]
  Shift                Shift[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([status])
  @@map("stores")
}

/// Tenant-level access role
model Role {
  id          String           @id @default(uuid()) @db.Uuid
  tenantId    String           @map("tenant_id") @db.Uuid
  name        String           @db.VarChar(100)
  code        String           @db.VarChar(50)
  description String?          @db.VarChar(255)
  isSystem    Boolean          @default(false) @map("is_system")
  status      RoleStatus       @default(ACTIVE)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  permissions RolePermission[]
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users       User[]

  @@unique([tenantId, code])
  @@index([tenantId])
  @@index([status])
  @@map("roles")
}

/// System permission
model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(100)
  name        String           @db.VarChar(100)
  module      String           @db.VarChar(100)
  description String?          @db.VarChar(255)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@index([module])
  @@map("permissions")
}

/// Junction between Role and Permission
model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// System user
model User {
  id                   String                @id @default(uuid()) @db.Uuid
  tenantId             String                @map("tenant_id") @db.Uuid
  storeId              String?               @map("store_id") @db.Uuid
  roleId               String                @map("role_id") @db.Uuid
  firstName            String                @map("first_name") @db.VarChar(100)
  lastName             String?               @map("last_name") @db.VarChar(100)
  email                String                @db.VarChar(255)
  phone                String?               @db.VarChar(50)
  passwordHash         String                @map("password_hash") @db.VarChar(255)
  status               UserStatus            @default(ACTIVE)
  lastLoginAt          DateTime?             @map("last_login_at") @db.Timestamptz(6)
  createdAt            DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  refreshTokens        RefreshToken[]
  role                 Role                  @relation(fields: [roleId], references: [id])
  store                Store?                @relation(fields: [storeId], references: [id])
  tenant               Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales                Sale[]
  purchases            Purchase[]
  goodsReceipts        GoodsReceipt[]
  stockMovements       StockMovement[]
  inventoryAdjustments InventoryAdjustment[]
  createdTransfers     StockTransfer[]       @relation("TransferCreatedBy")
  shippedTransfers     StockTransfer[]       @relation("TransferShippedBy")
  receivedTransfers    StockTransfer[]       @relation("TransferReceivedBy")
  saleReturns          SaleReturn[]
  authorizedCustomers  AuthorizedCustomer[]
  auditLogs            AuditLog[]
  openedShifts         Shift[]               @relation("ShiftOpenedBy")
  closedShifts         Shift[]               @relation("ShiftClosedBy")
  overriddenShifts     Shift[]               @relation("ShiftManagerOverride")

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([storeId])
  @@index([roleId])
  @@index([email])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(255)
  deviceName String?   @map("device_name") @db.VarChar(100)
  ipAddress  String?   @map("ip_address") @db.VarChar(50)
  userAgent  String?   @map("user_agent") @db.VarChar(500)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([revokedAt])
  @@map("refresh_tokens")
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum StoreStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RoleStatus {
  ACTIVE
  INACTIVE
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum ProductStatus {
  ACTIVE
  INACTIVE
  DRAFT
}

enum InventoryStatus {
  ACTIVE
  INACTIVE
}

/// Product stock level per store
model Inventory {
  id               String          @id @default(uuid()) @db.Uuid
  tenantId         String          @map("tenant_id") @db.Uuid
  storeId          String          @map("store_id") @db.Uuid
  productId        String          @map("product_id") @db.Uuid
  quantityOnHand   Decimal         @map("quantity_on_hand") @db.Decimal(10, 2)
  reservedQuantity Decimal         @default(0) @map("reserved_quantity") @db.Decimal(10, 2)
  minimumStock     Decimal         @map("minimum_stock") @db.Decimal(10, 2)
  maximumStock     Decimal         @map("maximum_stock") @db.Decimal(10, 2)
  reorderLevel     Decimal         @map("reorder_level") @db.Decimal(10, 2)
  status           InventoryStatus @default(ACTIVE)
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant           Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store            Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product          Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements   StockMovement[]

  @@unique([storeId, productId])
  @@index([tenantId])
  @@index([storeId])
  @@index([productId])
  @@index([status])
  @@map("inventories")
}

/// Inventory product
model Product {
  id                       String                    @id @default(uuid()) @db.Uuid
  tenantId                 String                    @map("tenant_id") @db.Uuid
  sku                      String                    @db.VarChar(100)
  barcode                  String?                   @db.VarChar(100)
  name                     String                    @db.VarChar(255)
  description              String?                   @db.Text
  category                 String?                   @db.VarChar(100)
  brand                    String?                   @db.VarChar(100)
  unit                     String                    @db.VarChar(50)
  costPrice                Decimal                   @map("cost_price") @db.Decimal(10, 2)
  sellingPrice             Decimal                   @map("selling_price") @db.Decimal(10, 2)
  vatRate                  Decimal                   @map("vat_rate") @db.Decimal(5, 2)
  imageUrl                 String?                   @map("image_url") @db.VarChar(1024)
  trackInventory           Boolean                   @default(true) @map("track_inventory")
  status                   ProductStatus             @default(ACTIVE)
  createdBy                String?                   @map("created_by") @db.Uuid
  updatedBy                String?                   @map("updated_by") @db.Uuid
  createdAt                DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  tenant                   Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  inventories              Inventory[]
  saleItems                SaleItem[]
  purchaseItems            PurchaseItem[]
  goodsReceiptItems        GoodsReceiptItem[]
  stockMovements           StockMovement[]
  inventoryAdjustmentItems InventoryAdjustmentItem[]
  stockTransferItems       StockTransferItem[]
  saleReturnItems          SaleReturnItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
  @@index([tenantId])
  @@index([status])
  @@index([category])
  @@index([brand])
  @@map("products")
}

enum PaymentMethod {
  CASH
  CARD
  UPI
  BANK_TRANSFER
  OTHER
}

enum SaleStatus {
  COMPLETED
  VOIDED
  REFUNDED
}

/// A completed or voided sale record
model Sale {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  storeId        String        @map("store_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  customerId     String?       @map("customer_id") @db.Uuid
  customerName   String?       @map("customer_name") @db.VarChar(255)
  customerCode   String?       @map("customer_code") @db.VarChar(100)
  saleNumber     String        @map("sale_number") @db.VarChar(50)
  subtotal       Decimal       @db.Decimal(10, 2)
  taxAmount      Decimal       @map("tax_amount") @db.Decimal(10, 2)
  discountAmount Decimal       @default(0) @map("discount_amount") @db.Decimal(10, 2)
  grandTotal     Decimal       @map("grand_total") @db.Decimal(10, 2)
  paymentMethod  PaymentMethod @default(CASH) @map("payment_method")
  status         SaleStatus    @default(COMPLETED)
  notes          String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant   Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store    Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  customer Customer?    @relation(fields: [customerId], references: [id])
  items    SaleItem[]
  returns  SaleReturn[] @relation("SaleToSaleReturn")
  Shift    Shift?       @relation(fields: [shiftId], references: [id])
  shiftId  String?      @db.Uuid

  @@unique([tenantId, saleNumber])
  @@index([tenantId])
  @@index([storeId])
  @@index([userId])
  @@index([customerId])
  @@index([status])
  @@map("sales")
}

/// Snapshot of a product sold at a specific time
model SaleItem {
  id               String   @id @default(uuid()) @db.Uuid
  saleId           String   @map("sale_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  productName      String   @map("product_name") @db.VarChar(255)
  sku              String   @db.VarChar(100)
  barcode          String?  @db.VarChar(100)
  quantity         Decimal  @db.Decimal(10, 2)
  returnedQuantity Decimal  @default(0) @map("returned_quantity") @db.Decimal(10, 2)
  unitPrice        Decimal  @map("unit_price") @db.Decimal(10, 2)
  vatRate          Decimal  @map("vat_rate") @db.Decimal(5, 2)
  lineTotal        Decimal  @map("line_total") @db.Decimal(10, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  sale        Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product          @relation(fields: [productId], references: [id])
  returnItems SaleReturnItem[] @relation("SaleItemToSaleReturnItem")

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

/// External vendor or supplier
model Supplier {
  id                    String         @id @default(uuid()) @db.Uuid
  tenantId              String         @map("tenant_id") @db.Uuid
  supplierCode          String         @map("supplier_code") @db.VarChar(100)
  name                  String         @db.VarChar(255)
  contactName           String?        @map("contact_name") @db.VarChar(255)
  email                 String?        @db.VarChar(255)
  phone                 String?        @db.VarChar(50)
  addressLine1          String?        @map("address_line_1") @db.VarChar(255)
  addressLine2          String?        @map("address_line_2") @db.VarChar(255)
  city                  String?        @db.VarChar(100)
  state                 String?        @db.VarChar(100)
  postalCode            String?        @map("postal_code") @db.VarChar(50)
  country               String?        @db.VarChar(100)
  taxRegistrationNumber String?        @map("tax_registration_number") @db.VarChar(100)
  paymentTerms          String?        @map("payment_terms") @db.VarChar(100)
  creditLimit           Decimal?       @map("credit_limit") @db.Decimal(10, 2)
  notes                 String?        @db.Text
  status                SupplierStatus @default(ACTIVE)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant    Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchases Purchase[]

  @@unique([tenantId, supplierCode])
  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([status])
  @@map("suppliers")
}

enum PurchaseStatus {
  DRAFT
  APPROVED
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model Purchase {
  id             String         @id @default(uuid()) @db.Uuid
  tenantId       String         @map("tenant_id") @db.Uuid
  purchaseNumber String         @map("purchase_number") @db.VarChar(50)
  supplierId     String         @map("supplier_id") @db.Uuid
  supplierName   String         @map("supplier_name") @db.VarChar(255)
  supplierCode   String         @map("supplier_code") @db.VarChar(100)
  storeId        String         @map("store_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  currency       String         @db.VarChar(10)
  orderDate      DateTime?      @map("order_date") @db.Date
  expectedDate   DateTime?      @map("expected_date") @db.Date
  subtotal       Decimal        @db.Decimal(10, 2)
  taxAmount      Decimal        @map("tax_amount") @db.Decimal(10, 2)
  discountAmount Decimal        @default(0) @map("discount_amount") @db.Decimal(10, 2)
  grandTotal     Decimal        @map("grand_total") @db.Decimal(10, 2)
  status         PurchaseStatus @default(DRAFT)
  notes          String?        @db.Text
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store         Store          @relation(fields: [storeId], references: [id])
  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  user          User           @relation(fields: [userId], references: [id])
  items         PurchaseItem[]
  goodsReceipts GoodsReceipt[]

  @@unique([tenantId, purchaseNumber])
  @@index([tenantId])
  @@index([storeId])
  @@index([supplierId])
  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id               String   @id @default(uuid()) @db.Uuid
  purchaseId       String   @map("purchase_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  productName      String   @map("product_name") @db.VarChar(255)
  sku              String   @db.VarChar(100)
  unit             String   @db.VarChar(50)
  orderedQuantity  Decimal  @map("ordered_quantity") @db.Decimal(10, 2)
  receivedQuantity Decimal  @default(0) @map("received_quantity") @db.Decimal(10, 2)
  unitCost         Decimal  @map("unit_cost") @db.Decimal(10, 2)
  vatRate          Decimal  @map("vat_rate") @db.Decimal(5, 2)
  lineTotal        Decimal  @map("line_total") @db.Decimal(10, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  purchase          Purchase           @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product           Product            @relation(fields: [productId], references: [id])
  goodsReceiptItems GoodsReceiptItem[]

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

enum GoodsReceiptStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model GoodsReceipt {
  id            String             @id @default(uuid()) @db.Uuid
  tenantId      String             @map("tenant_id") @db.Uuid
  purchaseId    String             @map("purchase_id") @db.Uuid
  storeId       String             @map("store_id") @db.Uuid
  receivedBy    String             @map("received_by") @db.Uuid
  receiptNumber String             @map("receipt_number") @db.VarChar(50)
  status        GoodsReceiptStatus @default(DRAFT)
  notes         String?            @db.Text
  receivedAt    DateTime           @default(now()) @map("received_at") @db.Timestamptz(6)
  createdAt     DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  purchase       Purchase           @relation(fields: [purchaseId], references: [id])
  store          Store              @relation(fields: [storeId], references: [id])
  receivedByUser User               @relation(fields: [receivedBy], references: [id])
  items          GoodsReceiptItem[]

  @@unique([tenantId, receiptNumber])
  @@index([tenantId])
  @@index([purchaseId])
  @@index([storeId])
  @@index([status])
  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id               String   @id @default(uuid()) @db.Uuid
  goodsReceiptId   String   @map("goods_receipt_id") @db.Uuid
  purchaseItemId   String   @map("purchase_item_id") @db.Uuid
  productId        String   @map("product_id") @db.Uuid
  productName      String   @map("product_name") @db.VarChar(255)
  sku              String   @db.VarChar(100)
  receivedQuantity Decimal  @map("received_quantity") @db.Decimal(10, 2)
  unitCost         Decimal  @map("unit_cost") @db.Decimal(10, 2)
  vatRate          Decimal  @map("vat_rate") @db.Decimal(5, 2)
  lineTotal        Decimal  @map("line_total") @db.Decimal(10, 2)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  goodsReceipt GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  purchaseItem PurchaseItem @relation(fields: [purchaseItemId], references: [id])
  product      Product      @relation(fields: [productId], references: [id])

  @@index([goodsReceiptId])
  @@index([purchaseItemId])
  @@index([productId])
  @@map("goods_receipt_items")
}

enum MovementType {
  PURCHASE_RECEIPT
  SALE
  ADJUSTMENT
  TRANSFER_IN
  TRANSFER_OUT
  RETURN_IN
  RETURN_OUT
  SALE_RETURN
}

enum ReferenceType {
  PURCHASE
  SALE
  TRANSFER
  ADJUSTMENT
  RETURN
}

model StockMovement {
  id            String        @id @default(uuid()) @db.Uuid
  tenantId      String        @map("tenant_id") @db.Uuid
  storeId       String        @map("store_id") @db.Uuid
  productId     String        @map("product_id") @db.Uuid
  inventoryId   String        @map("inventory_id") @db.Uuid
  referenceType ReferenceType @map("reference_type")
  referenceId   String        @map("reference_id") @db.VarChar(100)
  movementType  MovementType  @map("movement_type")
  quantity      Decimal       @db.Decimal(10, 2)
  balanceBefore Decimal       @map("balance_before") @db.Decimal(10, 2)
  balanceAfter  Decimal       @map("balance_after") @db.Decimal(10, 2)
  remarks       String?       @db.Text
  performedBy   String        @map("performed_by") @db.Uuid
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  tenant          Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store           Store     @relation(fields: [storeId], references: [id])
  product         Product   @relation(fields: [productId], references: [id])
  inventory       Inventory @relation(fields: [inventoryId], references: [id])
  performedByUser User      @relation(fields: [performedBy], references: [id])

  @@index([tenantId])
  @@index([storeId])
  @@index([productId])
  @@index([inventoryId])
  @@index([referenceId])
  @@map("stock_movements")
}

enum AdjustmentReason {
  DAMAGED
  EXPIRED
  THEFT
  LOST
  FOUND
  STOCK_COUNT
  MANUAL
}

enum AdjustmentStatus {
  DRAFT
  COMPLETED
  CANCELLED
}

model InventoryAdjustment {
  id               String           @id @default(uuid()) @db.Uuid
  tenantId         String           @map("tenant_id") @db.Uuid
  storeId          String           @map("store_id") @db.Uuid
  adjustmentNumber String           @map("adjustment_number") @db.VarChar(50)
  reason           AdjustmentReason
  status           AdjustmentStatus @default(DRAFT)
  notes            String?          @db.Text
  createdBy        String           @map("created_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant        Tenant                    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store         Store                     @relation(fields: [storeId], references: [id])
  createdByUser User                      @relation(fields: [createdBy], references: [id])
  items         InventoryAdjustmentItem[]

  @@unique([tenantId, adjustmentNumber])
  @@index([tenantId])
  @@index([storeId])
  @@index([status])
  @@map("inventory_adjustments")
}

model InventoryAdjustmentItem {
  id             String   @id @default(uuid()) @db.Uuid
  adjustmentId   String   @map("adjustment_id") @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  productName    String   @map("product_name") @db.VarChar(255)
  sku            String   @db.VarChar(100)
  quantityChange Decimal  @map("quantity_change") @db.Decimal(10, 2)
  unitCost       Decimal  @map("unit_cost") @db.Decimal(10, 2)
  totalValue     Decimal  @map("total_value") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  adjustment InventoryAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  product    Product             @relation(fields: [productId], references: [id])

  @@index([adjustmentId])
  @@index([productId])
  @@map("inventory_adjustment_items")
}

enum TransferType {
  STORE_TO_STORE
  STORE_TO_WAREHOUSE
  WAREHOUSE_TO_STORE
}

enum TransferStatus {
  DRAFT
  SHIPPED
  RECEIVED
  CANCELLED
}

model StockTransfer {
  id                 String         @id @default(uuid()) @db.Uuid
  tenantId           String         @map("tenant_id") @db.Uuid
  transferNumber     String         @map("transfer_number") @db.VarChar(50)
  transferType       TransferType   @default(STORE_TO_STORE) @map("transfer_type")
  sourceStoreId      String         @map("source_store_id") @db.Uuid
  destinationStoreId String         @map("destination_store_id") @db.Uuid
  status             TransferStatus @default(DRAFT)
  notes              String?        @db.Text
  receivedNotes      String?        @map("received_notes") @db.Text
  carrier            String?        @db.VarChar(100)
  vehicleNumber      String?        @map("vehicle_number") @db.VarChar(100)
  trackingNumber     String?        @map("tracking_number") @db.VarChar(100)
  createdBy          String         @map("created_by") @db.Uuid
  shippedBy          String?        @map("shipped_by") @db.Uuid
  receivedBy         String?        @map("received_by") @db.Uuid
  shippedAt          DateTime?      @map("shipped_at") @db.Timestamptz(6)
  receivedAt         DateTime?      @map("received_at") @db.Timestamptz(6)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant           Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sourceStore      Store               @relation("SourceTransfers", fields: [sourceStoreId], references: [id])
  destinationStore Store               @relation("DestinationTransfers", fields: [destinationStoreId], references: [id])
  createdByUser    User                @relation("TransferCreatedBy", fields: [createdBy], references: [id])
  shippedByUser    User?               @relation("TransferShippedBy", fields: [shippedBy], references: [id])
  receivedByUser   User?               @relation("TransferReceivedBy", fields: [receivedBy], references: [id])
  items            StockTransferItem[]

  @@unique([tenantId, transferNumber])
  @@index([tenantId])
  @@index([sourceStoreId])
  @@index([destinationStoreId])
  @@index([status])
  @@map("stock_transfers")
}

model StockTransferItem {
  id          String   @id @default(uuid()) @db.Uuid
  transferId  String   @map("transfer_id") @db.Uuid
  productId   String   @map("product_id") @db.Uuid
  productName String   @map("product_name") @db.VarChar(255)
  sku         String   @db.VarChar(100)
  barcode     String?  @db.VarChar(100)
  unit        String   @db.VarChar(50)
  quantity    Decimal  @db.Decimal(10, 2)
  unitCost    Decimal  @map("unit_cost") @db.Decimal(10, 2)
  totalValue  Decimal  @map("total_value") @db.Decimal(10, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  product  Product       @relation(fields: [productId], references: [id])

  @@index([transferId])
  @@index([productId])
  @@map("stock_transfer_items")
}

enum CustomerType {
  RETAIL
  WHOLESALE
  CORPORATE
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CustomerTier {
  STANDARD
  SILVER
  GOLD
  PLATINUM
}

model Customer {
  id           String         @id @default(uuid()) @db.Uuid
  tenantId     String         @map("tenant_id") @db.Uuid
  customerCode String         @map("customer_code") @db.VarChar(100)
  customerType CustomerType   @default(RETAIL) @map("customer_type")
  firstName    String         @map("first_name") @db.VarChar(255)
  lastName     String?        @map("last_name") @db.VarChar(255)
  phone        String         @db.VarChar(50)
  email        String?        @db.VarChar(255)
  addressLine1 String?        @map("address_line_1") @db.VarChar(255)
  addressLine2 String?        @map("address_line_2") @db.VarChar(255)
  city         String?        @db.VarChar(100)
  state        String?        @db.VarChar(100)
  postalCode   String?        @map("postal_code") @db.VarChar(50)
  country      String?        @db.VarChar(100)
  dob          DateTime?      @db.Date
  gender       String?        @db.VarChar(50)
  gstNumber    String?        @map("gst_number") @db.VarChar(100)
  status       CustomerStatus @default(ACTIVE)

  // Financial & Loyalty
  creditLimit        Decimal      @default(0) @map("credit_limit") @db.Decimal(10, 2)
  outstandingBalance Decimal      @default(0) @map("outstanding_balance") @db.Decimal(10, 2)
  currentPoints      Decimal      @default(0) @map("current_points") @db.Decimal(10, 2)
  lifetimePoints     Decimal      @default(0) @map("lifetime_points") @db.Decimal(10, 2)
  tier               CustomerTier @default(STANDARD)

  // Marketing
  marketingOptIn Boolean @default(false) @map("marketing_opt_in")
  smsEnabled     Boolean @default(true) @map("sms_enabled")
  emailEnabled   Boolean @default(true) @map("email_enabled")

  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sales       Sale[]
  saleReturns SaleReturn[]

  @@unique([tenantId, customerCode])
  @@unique([tenantId, phone])
  @@index([tenantId])
  @@index([status])
  @@index([customerType])
  @@map("customers")
}

enum ReturnType {
  FULL_RETURN
  PARTIAL_RETURN
}

enum ReturnReason {
  DEFECTIVE
  WRONG_ITEM
  CUSTOMER_CHANGE_MIND
  OTHER
}

enum ReturnStatus {
  COMPLETED
  CANCELLED
}

model SaleReturn {
  id             String        @id @default(uuid()) @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  storeId        String        @map("store_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  customerId     String?       @map("customer_id") @db.Uuid
  originalSaleId String        @map("original_sale_id") @db.Uuid
  returnNumber   String        @map("return_number") @db.VarChar(50)
  returnType     ReturnType    @default(FULL_RETURN) @map("return_type")
  subtotal       Decimal       @db.Decimal(10, 2)
  taxAmount      Decimal       @map("tax_amount") @db.Decimal(10, 2)
  refundTotal    Decimal       @map("refund_total") @db.Decimal(10, 2)
  refundMethod   PaymentMethod @default(CASH) @map("refund_method")
  status         ReturnStatus  @default(COMPLETED)
  notes          String?       @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant       Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store        Store            @relation(fields: [storeId], references: [id])
  user         User             @relation(fields: [userId], references: [id])
  customer     Customer?        @relation(fields: [customerId], references: [id])
  originalSale Sale             @relation("SaleToSaleReturn", fields: [originalSaleId], references: [id])
  items        SaleReturnItem[]
  Shift        Shift?           @relation(fields: [shiftId], references: [id])
  shiftId      String?          @db.Uuid

  @@unique([tenantId, returnNumber])
  @@index([tenantId])
  @@index([storeId])
  @@index([originalSaleId])
  @@index([status])
  @@map("sale_returns")
}

model SaleReturnItem {
  id           String       @id @default(uuid()) @db.Uuid
  saleReturnId String       @map("sale_return_id") @db.Uuid
  saleItemId   String       @map("sale_item_id") @db.Uuid
  productId    String       @map("product_id") @db.Uuid
  productName  String       @map("product_name") @db.VarChar(255)
  sku          String       @db.VarChar(100)
  barcode      String?      @db.VarChar(100)
  quantity     Decimal      @db.Decimal(10, 2)
  unitPrice    Decimal      @map("unit_price") @db.Decimal(10, 2)
  vatRate      Decimal      @map("vat_rate") @db.Decimal(5, 2)
  lineTotal    Decimal      @map("line_total") @db.Decimal(10, 2)
  reason       ReturnReason
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  saleReturn SaleReturn @relation(fields: [saleReturnId], references: [id], onDelete: Cascade)
  saleItem   SaleItem   @relation("SaleItemToSaleReturnItem", fields: [saleItemId], references: [id])
  product    Product    @relation(fields: [productId], references: [id])

  @@index([saleReturnId])
  @@index([saleItemId])
  @@index([productId])
  @@map("sale_return_items")
}

// ==========================================
// SYSTEM LEVEL MODELS (Phase 19)
// ==========================================

enum AuthCustomerStatus {
  ACTIVE
  REVOKED
}

model AuthorizedCustomer {
  id             String             @id @default(uuid()) @db.Uuid
  email          String?            @db.VarChar(255)
  phone          String?            @db.VarChar(50)
  plan           String             @db.VarChar(100)
  status         AuthCustomerStatus @default(ACTIVE)
  addedByAdminId String             @map("added_by_admin_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  adminUser    User          @relation(fields: [addedByAdminId], references: [id])
  otpCodes     OtpCode[]
  downloadLogs DownloadLog[]

  @@index([email])
  @@index([phone])
  @@index([status])
  @@map("authorized_customers")
}

enum OtpChannel {
  EMAIL
  SMS
}

model OtpCode {
  id           String     @id @default(uuid()) @db.Uuid
  customerId   String     @map("customer_id") @db.Uuid
  channel      OtpChannel @default(EMAIL)
  codeHash     String     @map("code_hash") @db.VarChar(255)
  expiresAt    DateTime   @map("expires_at") @db.Timestamptz(6)
  attemptCount Int        @default(0) @map("attempt_count")
  verifiedAt   DateTime?  @map("verified_at") @db.Timestamptz(6)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  customer AuthorizedCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("otp_codes")
}

model DownloadLog {
  id               String   @id @default(uuid()) @db.Uuid
  customerId       String   @map("customer_id") @db.Uuid
  ipAddress        String   @map("ip_address") @db.VarChar(50)
  installerVersion String   @map("installer_version") @db.VarChar(50)
  downloadedAt     DateTime @default(now()) @map("downloaded_at") @db.Timestamptz(6)

  customer AuthorizedCustomer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("download_logs")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  action    String   @db.VarChar(100)
  entity    String   @db.VarChar(100)
  entityId  String   @map("entity_id") @db.VarChar(100)
  adminId   String   @map("admin_id") @db.Uuid
  details   Json?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  adminUser User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([entity])
  @@map("audit_logs")
}

model SyncEvent {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  storeId      String   @map("store_id") @db.Uuid
  eventId      String   @map("event_id") @db.VarChar(100)
  eventType    String   @map("event_type") @db.VarChar(50)
  payload      Json
  status       String   @db.VarChar(50) // SUCCESS, FAILED
  errorMessage String?  @map("error_message")
  processedAt  DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  tenant Tenant @relation(fields: [tenantId], references: [id])
  store  Store  @relation(fields: [storeId], references: [id])

  @@unique([tenantId, eventId])
  @@index([tenantId, storeId])
  @@map("sync_events")
}

// ==========================================
// SHIFTS (Phase 21)
// ==========================================

enum ShiftStatus {
  OPEN
  CLOSED
}

model Shift {
  id                String  @id @default(uuid()) @db.Uuid
  tenantId          String  @map("tenant_id") @db.Uuid
  storeId           String  @map("store_id") @db.Uuid
  openedById        String  @map("opened_by_id") @db.Uuid
  closedById        String? @map("closed_by_id") @db.Uuid
  managerOverrideId String? @map("manager_override_id") @db.Uuid

  status   ShiftStatus @default(OPEN)
  openedAt DateTime    @map("opened_at") @db.Timestamptz(6)
  closedAt DateTime?   @map("closed_at") @db.Timestamptz(6)

  startingFloat Decimal  @default(0) @map("starting_float") @db.Decimal(10, 2)
  declaredCash  Decimal? @map("declared_cash") @db.Decimal(10, 2)
  expectedCash  Decimal? @map("expected_cash") @db.Decimal(10, 2)
  variance      Decimal? @db.Decimal(10, 2)

  zReportNumber Int?  @map("z_report_number") // Sequential per store
  zReportData   Json? @map("z_report_data") // Immutable snapshot

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  tenant          Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  store           Store  @relation(fields: [storeId], references: [id])
  openedBy        User   @relation("ShiftOpenedBy", fields: [openedById], references: [id])
  closedBy        User?  @relation("ShiftClosedBy", fields: [closedById], references: [id])
  managerOverride User?  @relation("ShiftManagerOverride", fields: [managerOverrideId], references: [id])

  sales   Sale[]
  returns SaleReturn[]

  @@unique([storeId, zReportNumber])
  @@index([tenantId])
  @@index([storeId])
  @@index([status])
  @@map("shifts")
}
