# ==========================================
# INFYPOS Monorepo Root .gitignore
# ==========================================

# Dependencies
node_modules/
backend/node_modules/
frontend/node_modules/
.pnp
.pnp.*

# Build Outputs & Compiled Code
dist/
backend/dist/
frontend/.next/
frontend/out/
build/
*.tsbuildinfo

# Environment Variables & Secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Logs & Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDEs & Editor Configuration
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.swp
*.swo
*.sublime-workspace
*.sublime-project
.project
.classpath
.settings/

# Testing & Coverage
coverage/
.nyc_output/

# Prisma & Generated Assets
/generated/prisma
.temp/
.tmp/
pids/
*.pid
*.seed
*.pid.lock

# Temporary Scratch Files & Local Artifacts
.agents/
.claude/
.windsurf/
scratch/
structure.txt
src-structure.txt
prisma-structure.txt
trash/
