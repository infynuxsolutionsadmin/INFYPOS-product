NODE_ENV=development

APP_NAME=INFEPOS Backend
APP_PORT=3000
APP_HOST=0.0.0.0

API_PREFIX=api
API_VERSION=v1

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/infypos?schema=public
DATABASE_POOL_SIZE=20

# JWT Authentication Secrets (Minimum 32 characters, distinct, no leading/trailing whitespace)
# Generate production/staging secrets using: openssl rand -base64 32
# In development/test environments, if omitted, non-production dummy defaults are assigned with a warning.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES=7d
RESET_PASSWORD_SECRET=
RESET_PASSWORD_EXPIRES_IN=1h

# Security & Redis
BCRYPT_SALT_ROUNDS=12
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Storage
STORAGE_DRIVER=local
STORAGE_UPLOAD_DIR=./uploads

# Stripe SaaS Subscriptions & Billing
# Obtain test/live API keys from Stripe Dashboard (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_placeholder_for_stripe
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_for_stripe
STRIPE_WEBHOOK_SECRET=whsec_placeholder_for_stripe
FRONTEND_URL=http://localhost:5173
