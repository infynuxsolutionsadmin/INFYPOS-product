meta {
  name: 01 List Products (query params)
  type: http
  seq: 1
}

get {
  url: {{base_url}}/products
  body: none
  auth: bearer
}

auth:bearer {
  token: {{access_token}}
}

params:query {
  page: 1
  limit: 20
  search: 
}

tests {
  test("Status is 200", function() {
    expect(res.status).to.equal(200);
  });
  test("Response has data", function() {
    expect(res.body).to.have.property("data");
  });
  test("Query params parsed correctly - limit respected", function() {
    const data = res.body.data || [];
    const items = Array.isArray(data) ? data : (data.items || []);
    expect(items.length).to.be.at.most(20);
  });
}
